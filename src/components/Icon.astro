---
import { ICONS, type IconName } from '../icons';

interface Props {
	name: IconName;
	size?: number;
	class?: string;
	/** Text for screen readers. Without it the icon is decorative and hidden from them. */
	label?: string;
}

const { name, size = 20, class: className, label } = Astro.props;
const Svg = ICONS[name];
---

<Svg
	width={size}
	height={size}
	fill="currentColor"
	class:list={['icon', className]}
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
	focusable="false"
/>
