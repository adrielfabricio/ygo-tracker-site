---
/**
 * A real app screenshot inside a phone frame, served as AVIF/WebP at the sizes the frame renders.
 * Only the hero's screenshot is above the fold: it passes `eager` so it loads with high priority.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	/** Empty when a surrounding element already describes the scene. */
	alt: string;
	/** Rendered width of the frame in CSS pixels. */
	width?: number;
	eager?: boolean;
	class?: string;
}

const { src, alt, width = 300, eager = false, class: className } = Astro.props;
const screenWidth = width - 20;
---

<figure class:list={['phone', className]} style={`--phone-width:${width}px`}>
	<div class="screen" style={`aspect-ratio:${src.width} / ${src.height}`}>
		<Picture
			src={src}
			alt={alt}
			formats={['avif', 'webp']}
			widths={[screenWidth, screenWidth * 2, screenWidth * 3]}
			sizes={`${screenWidth}px`}
			loading={eager ? 'eager' : 'lazy'}
			fetchpriority={eager ? 'high' : 'auto'}
			class="shot"
		/>
		<span class="island" aria-hidden="true"></span>
	</div>
</figure>

<style>
	.phone {
		position: relative;
		width: var(--phone-width);
		max-width: 100%;
		margin: 0;
		padding: 10px;
		border-radius: calc(var(--phone-width) * 0.16);
		background: linear-gradient(160deg, #2a2318, #0d0b08 40%, #1e190d);
		box-shadow:
			0 0 0 1px rgba(227, 184, 75, 0.25),
			0 30px 80px rgba(0, 0, 0, 0.6),
			0 0 60px rgba(227, 184, 75, 0.12);
	}

	.screen {
		position: relative;
		overflow: hidden;
		border-radius: calc(var(--phone-width) * 0.127);
		background: var(--color-canvas);
	}

	.screen :global(.shot) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* The screenshot leaves the top centre empty where the camera sits on the device. */
	.island {
		position: absolute;
		top: 1.5%;
		left: 50%;
		width: 30%;
		height: 3.6%;
		border-radius: 999px;
		background: #000;
		translate: -50% 0;
	}
</style>
