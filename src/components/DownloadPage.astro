---
/**
 * Short link for bios, posts and printed QR codes: sends phones straight to their store and shows
 * both badges everywhere else (desktop, or with JavaScript off).
 */
import { appStoreUrl, playStoreUrl } from '../config/site';
import { COPY } from '../i18n/copy';
import type { Locale } from '../i18n/locales';
import Base from '../layouts/Base.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import StoreBadges from './StoreBadges.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = COPY[locale];
const stores = { ios: appStoreUrl(locale, 'download'), android: playStoreUrl(locale, 'download') };
---

<Base locale={locale} title={`${copy.download.title} | YGO Tracker`} description={copy.meta.description} noindex>
	<Header locale={locale} />
	<main id="main" class="container download">
		<h1>{copy.download.title}</h1>
		<p class="status" data-redirecting={copy.download.redirecting}>
			{copy.download.body}
		</p>
		<StoreBadges locale={locale} placement="download" eager class="download-badges" />
	</main>
	<Footer locale={locale} />
</Base>

<script is:inline define:vars={{ stores }}>
	const ua = navigator.userAgent;
	// iPadOS reports itself as a Mac; touch support tells them apart.
	const ios = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
	const target = ios ? stores.ios : /Android/.test(ua) ? stores.android : null;
	if (target) {
		const status = document.querySelector('.status');
		if (status) status.textContent = status.dataset.redirecting;
		location.replace(target);
	}
</script>

<style>
	.download {
		display: grid;
		gap: var(--space-3);
		justify-items: center;
		min-height: 60vh;
		align-content: center;
		padding-block: 80px;
		text-align: center;
	}

	h1 {
		font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.25rem);
	}

	.status {
		color: var(--color-text-secondary);
	}

	.download :global(.download-badges) {
		justify-content: center;
	}
</style>
