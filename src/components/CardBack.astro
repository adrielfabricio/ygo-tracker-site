---
/**
 * A card back in the app's own style: the Eye of Horus on gilded black with a foil sheen.
 * Original artwork; it deliberately does not imitate the official card back.
 */
import { Image } from 'astro:assets';

import eyeGlyph from '../assets/eye-glyph.png';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['card-back', className]} aria-hidden="true">
	<div class="frame">
		<span class="corner tl"></span>
		<span class="corner tr"></span>
		<span class="corner bl"></span>
		<span class="corner br"></span>
		<div class="halo"></div>
		<Image src={eyeGlyph} alt="" width={160} height={160} class="eye" />
	</div>
	<div class="sheen"></div>
</div>

<style>
	.card-back {
		position: relative;
		aspect-ratio: 59 / 86;
		overflow: hidden;
		padding: 7px;
		border-radius: 12px;
		background: linear-gradient(150deg, #f2d07e, #b0862c 40%, #e3b84b 60%, #8b6914);
		box-shadow:
			0 18px 40px rgba(0, 0, 0, 0.55),
			0 0 30px rgba(227, 184, 75, 0.18);
	}

	.frame {
		position: relative;
		display: grid;
		place-items: center;
		height: 100%;
		border: 1px solid rgba(242, 208, 126, 0.55);
		border-radius: 7px;
		background:
			repeating-linear-gradient(45deg, rgba(227, 184, 75, 0.05) 0 2px, transparent 2px 9px),
			radial-gradient(circle at 50% 45%, #2a2318, #0d0b08 70%);
	}

	.corner {
		position: absolute;
		width: 14px;
		height: 14px;
		border-color: rgba(242, 208, 126, 0.7);
		border-style: solid;
		border-width: 0;
	}

	.tl {
		top: 6px;
		left: 6px;
		border-top-width: 1px;
		border-left-width: 1px;
	}

	.tr {
		top: 6px;
		right: 6px;
		border-top-width: 1px;
		border-right-width: 1px;
	}

	.bl {
		bottom: 6px;
		left: 6px;
		border-bottom-width: 1px;
		border-left-width: 1px;
	}

	.br {
		right: 6px;
		bottom: 6px;
		border-right-width: 1px;
		border-bottom-width: 1px;
	}

	.halo {
		position: absolute;
		width: 70%;
		aspect-ratio: 1;
		border: 1px solid rgba(227, 184, 75, 0.35);
		border-radius: 50%;
		box-shadow:
			0 0 0 8px rgba(227, 184, 75, 0.06),
			0 0 40px rgba(227, 184, 75, 0.25);
	}

	.eye {
		position: relative;
		width: 52%;
		height: auto;
	}

	/* Foil: a band of light that crosses the card every few seconds. */
	.sheen {
		position: absolute;
		inset: -50%;
		background: linear-gradient(115deg, transparent 42%, rgba(255, 241, 196, 0.35) 50%, transparent 58%);
		animation: sheen 5s ease-in-out infinite;
		animation-delay: var(--sheen-delay, 0s);
		mix-blend-mode: screen;
	}

	@keyframes sheen {
		0%,
		60% {
			transform: translateX(-60%);
		}
		100% {
			transform: translateX(60%);
		}
	}
</style>
