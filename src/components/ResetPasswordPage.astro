---
/**
 * Landing page of the password-reset email, for when the link opens in a browser instead of the
 * app: a mail app's own browser, an app build without the ygotracker.app app links, a phone
 * without the app, or a computer. On a phone the button hands the code to the app through its
 * custom scheme; a universal link tapped on its own domain would not open the app. Nothing opens
 * on its own, and the code goes nowhere but that button and the language switch, which opens this
 * same page in the other language (the page's CSP in public/_headers blocks every third-party
 * script and connection).
 *
 * One page per language: the reset Worker's email links to the Portuguese one, and the header's
 * language switch carries the query string over to the English one.
 */
import { COPY } from '../i18n/copy';
import type { Locale } from '../i18n/locales';
import Base from '../layouts/Base.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import StoreBadges from './StoreBadges.astro';

interface Props {
	scheme: 'ygotracker' | 'ygotracker-dev';
	locale: Locale;
}

const { scheme, locale } = Astro.props;
const dev = scheme === 'ygotracker-dev';
const path = { 'pt-br': dev ? '/dev/reset-password' : '/reset-password', en: dev ? '/en/dev/reset-password' : '/en/reset-password' };
const other: Locale = locale === 'en' ? 'pt-br' : 'en';
const copy = COPY[locale].resetPassword;
---

<Base locale={locale} title={`${copy.title} | YGO Tracker`} description={copy.description} noindex>
	<meta slot="head" name="referrer" content="no-referrer" />
	<Header locale={locale} langHref={path[other]} />
	<main id="main" class="container reset" data-reset data-state="fallback">
		<section>
			<h1 class="title">{copy.title}</h1>
			<div data-show="phone">
				<p>{copy.phoneBody}</p>
				<a class="open-app" href={`${scheme}://reset-password`} data-open-app>
					{copy.openApp}
				</a>
				<p class="hint">{copy.noApp}</p>
			</div>
			<p data-show="computer">{copy.computerBody}</p>
			<p data-show="missing">{copy.missingBody}</p>
			<p data-show="fallback">{copy.fallbackBody}</p>
			<StoreBadges locale={locale} placement="reset-password" class="reset-badges" />
		</section>
	</main>
	<Footer locale={locale} />
</Base>

<script is:inline define:vars={{ scheme }}>
	const page = document.querySelector('[data-reset]');
	if (page) {
		// The language switch opens this page in the other language with the same code.
		document
			.querySelectorAll('[data-lang-switch]')
			.forEach((link) => link.setAttribute('href', link.getAttribute('href') + location.search));
		const ua = navigator.userAgent;
		// iPadOS reports itself as a Mac; touch support tells them apart.
		const phone = /iPhone|iPad|iPod|Android/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
		if (!new URLSearchParams(location.search).get('oobCode')) {
			page.dataset.state = 'missing';
		} else if (!phone) {
			page.dataset.state = 'computer';
		} else {
			// The query string (code included) goes only into this link, which opens the app.
			const href = `${scheme}://reset-password${location.search}`;
			page.querySelectorAll('[data-open-app]').forEach((link) => link.setAttribute('href', href));
			page.dataset.state = 'phone';
		}
	}
</script>

<style>
	.reset {
		display: grid;
		gap: var(--space-5);
		max-width: 560px;
		padding-block: 80px;
		text-align: center;
	}

	section {
		display: grid;
		gap: var(--space-3);
		justify-items: center;
	}

	.title {
		font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2rem);
	}

	p {
		color: var(--color-text-secondary);
	}

	[data-show] {
		display: none;
	}

	.reset[data-state='phone'] [data-show='phone'],
	.reset[data-state='computer'] [data-show='computer'],
	.reset[data-state='missing'] [data-show='missing'],
	.reset[data-state='fallback'] [data-show='fallback'] {
		display: grid;
		gap: var(--space-3);
		justify-items: center;
	}

	.open-app {
		display: inline-grid;
		place-items: center;
		height: 48px;
		padding: 0 var(--space-4);
		border-radius: var(--radius-button);
		background: var(--gradient-primary);
		box-shadow: var(--glow-cta);
		color: var(--color-on-primary);
		font-weight: 700;
		text-decoration: none;
	}

	.open-app:hover {
		color: var(--color-on-primary);
		filter: brightness(1.08);
	}

	.hint {
		font-size: 0.875rem;
	}

	.reset :global(.reset-badges) {
		justify-content: center;
	}
</style>
