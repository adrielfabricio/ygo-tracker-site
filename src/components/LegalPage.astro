---
import { getEntry, render } from 'astro:content';

import Base from '../layouts/Base.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';

interface Props {
	id: 'privacy-policy' | 'terms-of-use' | 'support';
}

const entry = await getEntry('legal', Astro.props.id);
if (!entry) throw new Error(`Missing legal document: ${Astro.props.id}`);
const { Content } = await render(entry);
---

<Base locale="en" title={entry.data.title} description={entry.data.description}>
	<Header locale="en" />
	<main id="main" class="container prose">
		<Content />
	</main>
	<Footer locale="en" />
</Base>

<style>
	.prose {
		max-width: calc(44rem + 2 * var(--gutter));
		padding-block: 56px 80px;
		color: var(--color-text-secondary);
		font-size: 1.0625rem;
		line-height: 1.7;
	}

	.prose :global(h1) {
		margin-bottom: var(--space-2);
		color: var(--color-primary);
		font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.25rem);
	}

	.prose :global(h2) {
		margin: 2.5rem 0 0.75rem;
		color: var(--color-primary);
		font-size: 1.375rem;
	}

	.prose :global(h3) {
		margin: 1.75rem 0 0.5rem;
		color: var(--color-text);
		font-family: var(--font-body);
		font-size: 1.125rem;
		font-weight: 600;
	}

	.prose :global(p),
	.prose :global(ul) {
		margin: 0 0 1rem;
	}

	.prose :global(strong) {
		color: var(--color-text);
	}

	.prose :global(li) {
		margin-bottom: 0.375rem;
	}
</style>
