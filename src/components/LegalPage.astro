---
import { getEntry, render } from 'astro:content';

import Base from '../layouts/Base.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';

interface Props {
	id: 'privacy-policy' | 'terms-of-use' | 'support';
}

const entry = await getEntry('legal', Astro.props.id);
if (!entry) throw new Error(`Missing legal document: ${Astro.props.id}`);
const { Content } = await render(entry);
---

<Base locale="en" title={entry.data.title} description={entry.data.description}>
	<Header locale="en" />
	<main id="main" class="container prose">
		<Content />
	</main>
	<Footer locale="en" />
</Base>
