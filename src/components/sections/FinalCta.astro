---
import { Image } from 'astro:assets';

import eyeGlyph from '../../assets/eye-glyph.png';
import { COPY } from '../../i18n/copy';
import type { Locale } from '../../i18n/locales';
import CardBack from '../CardBack.astro';
import StoreBadges from '../StoreBadges.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const final = COPY[locale].final;
---

<section class="section final" id="download" aria-labelledby="final-title">
	<div class="container">
		<div class="panel" data-reveal>
			<div class="rays" aria-hidden="true"></div>
			<CardBack class="corner-card left" />
			<CardBack class="corner-card right" />

			<div class="emblem" aria-hidden="true">
				<span class="ring r1"></span>
				<span class="ring r2"></span>
				<Image src={eyeGlyph} alt="" width={240} height={240} class="eye" />
			</div>

			<h2 id="final-title">{final.title}</h2>
			<p>{final.body}</p>
			<StoreBadges locale={locale} placement="final" class="final-badges" />
		</div>
	</div>
</section>

<style>
	.panel {
		position: relative;
		display: grid;
		gap: var(--space-3);
		justify-items: center;
		overflow: hidden;
		padding: 72px var(--space-4) 64px;
		border: 1px solid var(--border-highlight);
		border-radius: 32px;
		background: radial-gradient(ellipse 70% 60% at 50% 20%, rgba(227, 184, 75, 0.18), transparent 70%), var(--color-card);
		box-shadow: 0 0 80px rgba(227, 184, 75, 0.1);
		text-align: center;
		isolation: isolate;
	}

	/* Light rays turning slowly behind the eye. */
	.rays {
		position: absolute;
		top: -40%;
		left: 50%;
		z-index: -1;
		width: 1100px;
		aspect-ratio: 1;
		translate: -50% 0;
		background: repeating-conic-gradient(from 0deg, rgba(227, 184, 75, 0.1) 0deg 5deg, transparent 5deg 15deg);
		mask: radial-gradient(circle, #000 0%, transparent 55%);
		animation: rays 80s linear infinite;
	}

	@keyframes rays {
		to {
			rotate: 360deg;
		}
	}

	.emblem {
		position: relative;
		display: grid;
		place-items: center;
		width: 140px;
		height: 140px;
		margin-bottom: var(--space-2);
	}

	.emblem :global(.eye) {
		position: relative;
		width: 112px;
		height: 112px;
		filter: drop-shadow(0 0 24px rgba(227, 184, 75, 0.55));
	}

	.ring {
		position: absolute;
		inset: 0;
		border: 1px solid rgba(227, 184, 75, 0.5);
		border-radius: 50%;
		animation: ripple 4s ease-out infinite;
	}

	.r2 {
		animation-delay: 2s;
	}

	@keyframes ripple {
		from {
			opacity: 0.8;
			transform: scale(0.6);
		}
		to {
			opacity: 0;
			transform: scale(1.6);
		}
	}

	h2 {
		max-width: 680px;
		font-size: clamp(1.875rem, 1.2rem + 2.6vw, 2.875rem);
		font-weight: 700;
	}

	p {
		color: var(--color-text-secondary);
		font-size: 1.125rem;
	}

	.panel :global(.final-badges) {
		justify-content: center;
		margin-top: var(--space-2);
	}

	.panel :global(.corner-card) {
		position: absolute;
		z-index: -1;
		display: none;
		width: 130px;
		opacity: 0.85;
	}

	@media (min-width: 900px) {
		.panel :global(.corner-card) {
			display: block;
		}
	}

	.panel :global(.corner-card.left) {
		bottom: -40px;
		left: 6%;
		rotate: -18deg;
		--sheen-delay: 0.8s;
	}

	.panel :global(.corner-card.right) {
		top: -30px;
		right: 6%;
		rotate: 16deg;
		--sheen-delay: 2.6s;
	}

	@media (prefers-reduced-motion: reduce) {
		.ring {
			display: none;
		}
	}
</style>
