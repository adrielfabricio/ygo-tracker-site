---
/**
 * Feature bento. Each card shows the real app screen for that feature, from screenshots taken on a
 * device running the production app (src/assets/screenshots/store). Offline sync and account
 * portability have no screen of their own, so they stay as text cards rather than invented UI.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import cardDetail from '../../assets/screenshots/store/card-detail.jpg';
import collections from '../../assets/screenshots/store/collections.jpg';
import qrShare from '../../assets/screenshots/store/qr-share.jpg';
import search from '../../assets/screenshots/store/search.jpg';
import wishlist from '../../assets/screenshots/store/wishlist.jpg';
import ydkeImport from '../../assets/screenshots/store/ydke-import.jpg';
import { COPY, type FeatureId } from '../../i18n/copy';
import type { Locale } from '../../i18n/locales';
import Icon from '../Icon.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = COPY[locale];
const alt = copy.screens;

/** `focus` is the vertical object-position: which part of a tall screen the card shows. */
const SCREENS: Partial<Record<FeatureId, { src: ImageMetadata; alt: string; focus?: string }[]>> = {
	// The needed/owned counters and the Main/Side position sit low on the card detail screen.
	decks: [{ src: cardDetail, alt: alt.cardDetail, focus: '92%' }],
	collections: [{ src: collections, alt: alt.collections }],
	wishlist: [{ src: wishlist, alt: alt.wishlist }],
	search: [{ src: search, alt: alt.search }],
	shopping: [
		{ src: qrShare, alt: alt.qrShare, focus: '72%' },
		{ src: ydkeImport, alt: alt.ydkeImport },
	],
};
---

<section class="section features" id="features" aria-labelledby="features-title">
	<div class="container">
		<div class="section-head" data-reveal>
			<p class="eyebrow">{copy.features.eyebrow}</p>
			<h2 id="features-title">{copy.features.title}</h2>
		</div>

		<ul class="bento">
			{copy.features.items.map((item, index) => (
				<li
					class:list={['tile', `tile-${item.id}`]}
					style={`grid-area:${item.id};--delay:${(index % 3) * 0.08}s`}
					data-reveal
					data-spotlight
				>
					<div class="screens">
						{(SCREENS[item.id] ?? []).map((screen) => (
							<div class="screen" style={`--focus:${screen.focus ?? '0%'}`}>
								<Picture
									src={screen.src}
									alt={screen.alt}
									formats={['avif', 'webp']}
									widths={[240, 480, 720]}
									sizes="240px"
									loading="lazy"
									class="shot"
								/>
							</div>
						))}
					</div>
					<div class="text">
						<h3>
							<Icon name={item.icon} size={20} />
							{item.title}
						</h3>
						<p>{item.body}</p>
					</div>
				</li>
			))}
		</ul>

		<ul class="extras">
			{copy.features.extras.map((item, index) => (
				<li class="extra" data-reveal style={`--delay:${index * 0.08}s`}>
					<span class="extra-icon">
						<Icon name={item.icon} size={22} />
					</span>
					<div>
						<h3>{item.title}</h3>
						<p>{item.body}</p>
					</div>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.features {
		background: radial-gradient(ellipse 50% 40% at 85% 10%, rgba(227, 184, 75, 0.07), transparent 70%), var(--color-sheet);
	}

	.bento,
	.extras {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.bento {
		display: grid;
		gap: var(--space-3);
		grid-template-areas:
			'decks'
			'collections'
			'wishlist'
			'search'
			'shopping';
	}

	@media (min-width: 680px) {
		.bento {
			grid-template-columns: repeat(2, 1fr);
			grid-template-areas:
				'decks collections'
				'wishlist search'
				'shopping shopping';
		}
	}

	@media (min-width: 1000px) {
		.bento {
			grid-template-columns: repeat(3, 1fr);
			grid-template-areas:
				'decks collections wishlist'
				'search shopping shopping';
		}
	}

	.tile {
		position: relative;
		display: grid;
		grid-template-rows: auto 1fr;
		overflow: hidden;
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-hero);
		background: var(--color-card);
		transition:
			border-color 0.3s ease,
			box-shadow 0.3s ease,
			translate 0.3s ease;
	}

	/* Spotlight under the pointer (position set by the page script). */
	.tile::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 0%), rgba(227, 184, 75, 0.1), transparent 60%);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
	}

	.tile:hover {
		border-color: var(--border-highlight);
		box-shadow: 0 0 30px rgba(227, 184, 75, 0.12);
		translate: 0 -4px;
	}

	.tile:hover::before {
		opacity: 1;
	}

	/* The top of each screen peeks out of the card and fades into it. */
	.screens {
		position: relative;
		display: flex;
		justify-content: center;
		gap: var(--space-3);
		height: 320px;
		padding: var(--space-4) var(--space-4) 0;
		overflow: hidden;
		background: radial-gradient(ellipse 70% 60% at 50% 0%, rgba(227, 184, 75, 0.14), transparent 70%);
	}

	.screens::after {
		content: '';
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 90px;
		background: linear-gradient(transparent, var(--color-card));
		pointer-events: none;
	}

	.screen {
		flex: 0 1 240px;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--border-primary);
		border-radius: 26px;
		box-shadow:
			0 18px 40px rgba(0, 0, 0, 0.45),
			0 0 30px rgba(227, 184, 75, 0.1);
		transition: translate 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.tile:hover .screen {
		translate: 0 -10px;
	}

	.screen :global(.shot) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% var(--focus);
	}

	.text {
		position: relative;
		z-index: 1;
		display: grid;
		align-content: start;
		gap: var(--space-2);
		padding: var(--space-3) var(--space-4) var(--space-4);
	}

	h3 {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: 1.1875rem;
	}

	h3 :global(.icon) {
		flex: none;
		color: var(--color-primary);
	}

	.text p,
	.extra p {
		color: var(--color-text-secondary);
	}

	/* Offline and account: text cards, no screen to show. */
	.extras {
		display: grid;
		gap: var(--space-3);
		margin-top: var(--space-3);
	}

	@media (min-width: 860px) {
		.extras {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.extra {
		display: flex;
		gap: var(--space-3);
		padding: var(--space-4);
		border: 1px solid var(--border-primary);
		border-radius: var(--radius-panel);
		background: var(--color-card);
		box-shadow: var(--glow-tile);
	}

	.extra h3 {
		margin-bottom: var(--space-1);
	}

	.extra-icon {
		display: grid;
		flex: none;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 1px solid var(--border-primary);
		border-radius: var(--radius-card);
		background: var(--color-primary-tint);
		color: var(--color-primary);
	}
</style>
