---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { COPY } from '../i18n/copy';
import Base from '../layouts/Base.astro';

// One page serves every missing URL, so it speaks both languages.
const pt = COPY['pt-br'].notFound;
const en = COPY.en.notFound;
---

<Base locale="pt-br" title={`${pt.title} | YGO Tracker`} description={COPY['pt-br'].meta.description} noindex>
	<Header locale="pt-br" />
	<main id="main" class="container not-found">
		<p class="code" aria-hidden="true">
			404
		</p>
		<h1>{pt.title}</h1>
		<p>{pt.body}</p>
		<a href="/">{pt.back}</a>
		<div lang="en" class="en">
			<p>
				{en.title}. {en.body}
			</p>
			<a href="/en">{en.back}</a>
		</div>
	</main>
	<Footer locale="pt-br" />
</Base>

<style>
	.not-found {
		display: grid;
		gap: var(--space-3);
		justify-items: center;
		min-height: 60vh;
		align-content: center;
		padding-block: 80px;
		text-align: center;
	}

	.code {
		color: var(--color-primary);
		font-family: var(--font-display);
		font-size: 4rem;
		font-weight: 700;
		line-height: 1;
	}

	h1 {
		font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.25rem);
	}

	p {
		color: var(--color-text-secondary);
	}

	.en {
		display: grid;
		gap: var(--space-2);
		margin-top: var(--space-4);
		padding-top: var(--space-4);
		border-top: 1px solid var(--border-subtle);
		font-size: 0.9375rem;
	}
</style>
