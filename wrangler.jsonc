{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Static-assets-only Worker: no script, Cloudflare serves dist/ directly.
	"name": "ygo-tracker-site",
	"compatibility_date": "2026-10-06",
	"assets": {
		"directory": "./dist",
		// `/privacy` serves privacy.html; `/privacy.html` and `/privacy/` redirect to it.
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
	},
	// The site lives only on its own domain; no workers.dev copy for search engines to index.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "ygotracker.app", "custom_domain": true }],
}
